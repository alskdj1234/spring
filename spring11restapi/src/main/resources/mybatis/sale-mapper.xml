<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.sale">
	
	<!-- 상품 기본 정보 등록 -->
	<select id="sequence" resultType="int">
		select sale_seq.nextval from dual
	</select>
	<insert id="add">
		insert into sale(
			sale_no, sale_name, sale_category,
			sale_original_price, sale_discount_price,
			sale_content, sale_stock
		)
		values(
			#{saleNo}, #{saleName}, #{saleCategory},
			#{saleOriginalPrice}, #{saleDiscountPrice},
			#{saleContent}, #{saleStock}
		)
	</insert>	
	
	<select id ="find" resultType="SaleDto">
	 	select * from sale where sale_no = #{saleNo}
	</select>
	<insert id="connect">
		insert into sale_thumbnail(sale_no, attach_no)
		values(#{saleNo),#(attachNo))
	</insert>
	
	<insert id="connectDetailImages">
		insert into sale_information (sale_no, attach_no)
		values( #{saleNo},#{attachNo})
	</insert>
</mapper>