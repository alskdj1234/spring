<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.attach">
	<!-- 등록 -->
	<select id="sequence" resultType="int">
		select attach_seq.nextval from dual
	</select>
	<insert id ="add">
	 insert into attach (
	 	attach_no, attach_name, attach_type, attach_size
	 )
		values(
			#{attachNo}, #{attachName}, #{attachType}, #{attachSize}
		)
		
	</insert>

	<!-- 상세 -->
	<select id="find" resultType="AttachDto">
	
		select *from attach where attach_no = #{attachNo}
	</select>
	
	<!--삭제  -->
	<delete id="delete">
	
		delete attach where attach_no =#{attachNo}
	</delete>
	
	<!-- 여러개 찾기 -->
	<select id="findList" resultType="AttachDto">
		select * from attach
		where attach_no in (
		<foreach item="attachNo" collection="list" separator=",">
			#{attachNo}
		</foreach>
		)
		order by attach_no asc
	</select>
	
</mapper>